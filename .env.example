# ==========================================
# MLBB Ranked Companion - Environment Configuration
# ==========================================
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit your .env file or real credentials to source control.

# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini AI API Key: Required for server-side AI draft analysis.
# In AI Studio, this is automatically injected from the Secrets manager.
# When running standalone/locally, obtain an API key from Google AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL: URL where the application is hosted.
# In AI Studio, this is automatically set to the Cloud Run service URL.
APP_URL="MY_APP_URL"
